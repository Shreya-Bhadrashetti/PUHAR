# Copy to `.env` in this directory. The API loads this file from the repo root.

ENVIRONMENT=development

# Local default is SQLite. Docker Compose overrides this with Postgres.
DATABASE_URL=sqlite:///./database/puhar.db
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60

# Vite UI is :5173. Docker nginx UI is :3000.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_ORIGIN=http://localhost:5173

GOOGLE_MAPS_API_KEY=
IMD_API_KEY=
COASTAL_WEATHER_API_KEY=

RATE_LIMIT_PER_MINUTE=60
